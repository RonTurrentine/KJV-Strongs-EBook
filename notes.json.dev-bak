  "John.3.17": {
    "text": "A perfect companion verse for [[Rom.8.1]].  With our salvation, we are no longer condemned, but saved by Jesus' righteousness!",
    "created": "2026-06-16T01:10:46.766Z",
    "tags": [
      "Condemnation"
    ],
    "updated": "2026-07-22T16:11:18.657Z"
  },
