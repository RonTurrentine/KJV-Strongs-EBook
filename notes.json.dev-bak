  "Matt.5.3": {
    "tags": [
      "humility"
    ],
    "updated": "2026-07-25T14:24:50.994Z",
    "text": "Humility is a necessary trait in a child of God.  See [[Ps.51.17]]. See also [[Jas.4.6]] and see the humble publican vs the Pharisee in [[Luke.18.9]]",
    "created": "2026-07-25T14:18:45.247Z"
  },
